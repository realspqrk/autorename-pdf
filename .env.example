# AutoRename-PDF: keys for the live provider tests (copy to .env in the repo
# root; never commit .env). Run them with:
#   AUTORENAME_LIVE=1 cargo test -p autorename-core --test providers_live -- --ignored --nocapture
# Tests without a key are skipped. For the app itself, put keys into the .env
# beside your config.yaml (`autorename-pdf config path`).
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
