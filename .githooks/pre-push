#!/bin/sh
# Release gate: no secrets or real-document data in what is pushed.
# Enable once per clone: git config core.hooksPath .githooks
# Skip only after checking a finding is a false positive: git push --no-verify
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue           # deleting a ref
  case "$local_ref" in refs/tags/*) local_sha="$local_sha^{commit}" ;; esac
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=origin/main
  else
    base=$remote_sha
  fi
  [ "$(git rev-parse "$base")" = "$(git rev-parse "$local_sha")" ] && continue
  cargo xtask leakcheck --range "$base..$local_sha" || status=1
done
exit $status
