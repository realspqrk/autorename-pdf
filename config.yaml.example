# AutoRename-PDF 4 — full config reference.
#
# Location: --config FILE > $AUTORENAME_PDF_CONFIG > OS config dir
#   Linux   ~/.config/autorename-pdf/config.yaml
#   Windows %APPDATA%\autorename-pdf\config.yaml
#   macOS   ~/Library/Application Support/autorename-pdf/config.yaml
# `autorename-pdf config init` writes a starter file there; `config path` prints it.
#
# Every key is optional; omitted keys (or `null`) use the defaults shown here.
# Unknown keys are errors. YAML 1.2: write true/false, not yes/no/on/off.
# `${VAR}` reads the environment first, then a .env file beside this file.
# Check with: autorename-pdf config validate
#
# Default filename (profile: business):  20260906 ACME AP 12,13.pdf
#   date · counterparty · AP (bill you received) / AR (invoice you sent) · printed total
# Recipes: examples/ (academic, er-ar, invoice-id, ollama-offline, vision-cloud)
config_version: 4

# cloud: use ai.provider below. offline: local/LAN Ollama only; any other
# network request is an error (exit 3). Same as the --offline flag.
privacy: cloud

ai:
  provider: openai              # openai | anthropic | gemini | xai | ollama
  model: null                   # null = provider default:
                                #   openai gpt-6-luna · anthropic claude-haiku-5-5
                                #   gemini gemini-3.5-flash-lite · xai grok-4.7 · ollama gemma4
  api_key: "${OPENAI_API_KEY}"  # literal key or ${VAR}; empty for ollama
  base_url: ""                  # empty = provider default (ollama: http://localhost:11434)
  temperature: 0.0
  max_retries: 2                # retries for retryable provider errors (429, 5xx, timeouts)

pdf:
  max_pages: 3                  # pages read and sent to the AI per PDF
  # Free first: text layer -> local OCR -> page images to the model.
  # Decided per page (the first max_pages pages).
  ocr: auto                     # true | false | auto. auto = pages scoring below the threshold.
                                # Needs `autorename-pdf models fetch`; auto without models:
                                # warning `ocr_models_missing`, then vision. true without models: error.
  vision: auto                  # true | false | auto. auto = only pages still below it after OCR.
                                # privacy: offline sends images to the local Ollama model only.
  text_quality_threshold: 0.8   # per-page score (0..1). Text-layer readability: 1 = clean text, any
                                # length; replacement/private-use/control chars and leftover mojibake
                                # lower it (2 % broken chars = 0.8). Pages with pictures or drawings
                                # (logos, scans) score at most 0.75, so above 0.75 they are read with
                                # OCR. After OCR a page scores its OCR text. 1.0 = clean text, no pictures.
  incoming_invoice: AP          # document_type for invoices you receive (German: ER)
  outgoing_invoice: AR          # document_type for invoices you send

ocr:
  language: auto                # auto = every installed model pack (latin: English, German, French
                                # and 45 more at once); or a pack id (latin) or language code (de)
  threads: 4                    # CPU threads for OCR inference

company:
  name: ""                      # YOUR company: excluded as counterparty, tells AP from AR

output:
  language: English             # language of non-invoice document types (Letter, Contract, ...)
  date_format: "%Y%m%d"         # strftime; incomplete dates render as 00000000
  amount_format: "{currency} {amount}"  # invoice amount in names, e.g. "{amount} {currency}"

enrich:
  enabled: true                 # embed Title/Subject/Keywords, XMP and an autorename-pdf.json
                                # attachment (incremental update; signed/encrypted/PDF-A skipped;
                                # undo restores the original bytes). Off for one run: --no-enrich

harmonization:
  auto_learn: true              # Name matching: learn variants of the profile's harmonize_field
                                # into name-lists/<field>.yaml beside this file (business:
                                # name-lists/company_name.yaml). Off for one run: --no-learn
  decider: ai                   # ambiguous matches: ai | openai-decisions | jev | off
                                # off = keep the new name, flagged `review: true`
  decider_api_key: ""           # key for openai-decisions / jev, e.g. "${JEV_API_KEY}" (.env).
                                # Empty: openai-decisions uses ai.api_key (provider openai)
                                # or OPENAI_API_KEY; jev uses JEV_API_KEY

prompt_extension: ""            # appended verbatim to the selected profile prompt

profile: business               # business | academic | a custom id under `profiles`

# Overlay a built-in (same id) or add a profile (new id, optional `extends`).
# Keys: intro, fields, template, truncate_field, harmonize_field, direction,
# amount, extends.
# Overlay: scalars replace, new fields append, `field: null` deletes a field.
# Derived fields (built-in `business`; `direction: null` / `amount: null` off):
#   direction: {field: document_type, issuer: issuer, recipient: recipient,
#               incoming: "{incoming_invoice}", outgoing: "{outgoing_invoice}"}
#     AP/AR come from who issued/received the invoice vs company.name, not
#     from the model; unclear → model's guess + warning `direction_uncertain`.
#   amount: {field: description, amount: total_amount, currency: currency}
#     description = output.amount_format with the printed amount + currency;
#     no currency → warning `currency_missing`.
#   No counterparty in the answer → warning `counterparty_missing` (review it;
#   a name only in a logo is read when the page goes to OCR, see pdf above).
# template = basename without .pdf; literal braces as {{ }}; truncate_field is
# shortened first when the name exceeds the length limit.
#   profiles:
#     business:
#       fields:
#         invoice_id:
#           description: "Copy the printed invoice number exactly. Empty if absent."
#       template: "{document_date} {company_name} {document_type} {description} {invoice_id}"
profiles: {}
