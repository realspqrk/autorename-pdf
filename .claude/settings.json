{
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all --check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(cargo xtask icons --check*)",
      "Bash(cargo run -q -p autorename-app -- --help*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "WebSearch",
      "WebFetch(*)"
    ],
    "deny": [
      "Edit(file_path=**/config.yaml)",
      "Write(file_path=**/config.yaml)",
      "Edit(file_path=**/.env)",
      "Write(file_path=**/.env)"
    ]
  }
}
